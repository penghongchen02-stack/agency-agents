# ─────────────────────────────────────────────────────────────────────────────
# Polymarket BTC 5m bot. Copy to .env and edit. NEVER commit .env.
# The bot reads this file locally and sends your key to no one. It only signs
# orders on your machine, and only Polymarket's own API sees the signed orders.
# ─────────────────────────────────────────────────────────────────────────────

# MODE: "paper" (default) simulates fills against the real order book.
#       "live" places real orders. It also needs LIVE_CONFIRM below.
MODE=paper
# Must be exactly this phrase for MODE=live to start.
LIVE_CONFIRM=

# ── Venue ──
# us     : Polymarket US (polymarket.us), CFTC-regulated, US residents with a verified account.
#          Settles on CF Benchmarks BRTI. Default.
# global : polymarket.com (not available to US persons).
VENUE=us

# ── Polymarket US API key (live mode only; leave empty for paper) ──
# Create it at polymarket.us/developer. The secret is a base64 Ed25519 private key.
# It only signs requests locally; it is never sent anywhere.
US_KEY_ID=
US_SECRET_KEY=

# ── Global wallet (VENUE=global, live mode only) ──
# Use a DEDICATED hot wallet holding only what you are willing to lose.
PRIVATE_KEY=
# Your Polymarket profile/proxy wallet address (where the USDC sits).
FUNDER_ADDRESS=
# 0 = EOA/MetaMask, 1 = email/Google (Magic proxy), 2 = Gnosis Safe
SIGNATURE_TYPE=1

# ── Which strategy and market ──
# fair-value   : our default, one buy per slot when the ask is below fair value
# twap-scratch : the original README's style (50¢ band, clips, scratch exits)
# winner-lock  : what the original .exe ran (buy the >90¢ favourite near the close)
STRATEGY=fair-value
# 5m or 15m BTC Up/Down markets
MARKET_WINDOW=5m

# ── Shared model settings ──
# Only trade when model probability beats the ask by this much (0.05 = 5¢)...
MIN_EDGE=0.05
# ...after the taker fee (θ × p × (1 − p) per contract; US API standard θ = 0.0695)...
# FEE_THETA=0.0695
# ...and this extra allowance for slippage (default 0.01 on US, 0.02 on global).
# FEE_BUFFER=0.01
# Volatility floor (bps per sqrt(second)), so a quiet tape can't create fake certainty.
MIN_VOL_BPS_PER_SQRT_SEC=0.8
# Poll interval for the decision loop.
POLL_MS=2000

# ── fair-value ──
# Never pay more than this per share, nor less than this (avoids dust tails).
MAX_ENTRY_PRICE=0.80
MIN_ENTRY_PRICE=0.20
# Entry window, in seconds after the slot opens.
ENTRY_START_SEC=30
ENTRY_END_SEC=240

# ── twap-scratch (values from the original README / .env.example) ──
TWAP_WINDOW_SEC=30
RESCORE_SEC=15
SCRATCH_ENTRY_START_SEC=5
SCRATCH_ENTRY_END_SEC=150
SCRATCH_MIN_PRICE=0.45
SCRATCH_MAX_PRICE=0.55
# Sell if our probability for the held side falls below this.
SCRATCH_EXIT_PROB=0.5
# Suggested: MAX_TRADES_PER_SLOT=3 and MAX_SLOT_USD=15 for this strategy.

# ── winner-lock (values found in the original .exe) ──
WL_LAST_SEC=60
WL_MIN_PRICE=0.90
WL_MAX_PRICE=0.96
# Our model must value the favourite at least this much above ask + fee buffer.
WL_MIN_EDGE=0.01
WL_FEE_BUFFER=0.005

# ── Risk limits (hard stops) ──
# Size of each buy ("clip").
STAKE_USD=5
MAX_TRADES_PER_SLOT=1
# Most USD that can go into one slot across all clips.
MAX_SLOT_USD=15
MAX_DAILY_LOSS_USD=25
MAX_DAILY_TRADES=60
# Paper mode starting bankroll.
PAPER_BANKROLL_USD=100
